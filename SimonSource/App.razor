@implements IAsyncDisposable

<div class="stage">
  <svg class="field" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid meet" @onclick="BackgroundTap">
    <defs>
      <filter id="smokeblur" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="25" /></filter>
      <filter id="glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="7" /></filter>
    </defs>

    @if (_phase != Phase.Finished)
    {
      @foreach (var s in _smoke)
      {
        var age = _now - s.Born;
        var t = Math.Clamp(age / s.Life, 0, 1);
        var alpha = (1 - t) * (1 - t) * s.Opacity;
        var cx = s.X + s.Vx * t;
        var cy = s.Y + s.Vy * t;
        var size = s.Radius * (1 + t * 2.6);
        <circle cx="@cx" cy="@cy" r="@size" fill="@s.Color" opacity="@alpha" filter="url(#smokeblur)"/>
      }

      @foreach (var b in _bursts)
      {
        var age = _now - b.Born;
        if (age < 650)
        {
          var p = Math.Clamp(age / 650, 0, 1);
          var r = 17 + p * (b.Style % 2 == 0 ? 85 : 120);
          var opacity = (1 - p) * (1 - p);
          var rayCount = b.Style switch { 0 => 9, 1 => 6, 2 => 13, 3 => 8, _ => 11 };
          <g opacity="@opacity">
            <circle cx="@b.X" cy="@b.Y" r="@(20 + p * 34)" fill="@b.Color" filter="url(#glow)"/>
            @for (var j = 0; j < rayCount; j++)
            {
              var theta = b.Angle + j * Math.PI * 2 / rayCount;
              var outer = r * (j % 3 == 0 ? 1.4 : 1.0);
              <line x1="@(b.X + Math.Cos(theta) * 10)" y1="@(b.Y + Math.Sin(theta) * 10)"
                    x2="@(b.X + Math.Cos(theta) * outer)" y2="@(b.Y + Math.Sin(theta) * outer)"
                    stroke="@b.Color" stroke-width="@(j % 3 == 0 ? 7 : 3)" stroke-linecap="round"/>
            }
            <circle cx="@b.X" cy="@b.Y" r="@(4 + (1 - p) * 9)" fill="white"/>
          </g>
        }
      }

      @if (_phase == Phase.Handoff)
      {
        var sweep = -100 + Math.Clamp((_now - _phaseAt) / 850, 0, 1) * 1200;
        <rect x="0" y="@sweep" width="1000" height="8" fill="#42ff9a" opacity="0.55" filter="url(#glow)" />
        <rect x="0" y="@sweep" width="1000" height="2" fill="#aaffd0" opacity="0.9" />
      }

      @if (_phase == Phase.Input)
      {
        @for (var i = 0; i < _sequence.Count; i++)
        {
          var index = i;
          var mark = _sequence[i];
          <g class="target" @onclick="() => Press(index)" @onclick:stopPropagation="true">
            <circle cx="@mark.X" cy="@mark.Y" r="49" fill="@mark.Color" opacity=".055"/>
            <circle cx="@mark.X" cy="@mark.Y" r="25" fill="none" stroke="@mark.Color" stroke-width="2.5" opacity=".62"/>
            <circle cx="@mark.X" cy="@mark.Y" r="6" fill="@mark.Color" opacity=".85"/>
          </g>
        }
      }

      @if (_phase == Phase.Fade)
      {
        var opacity = Math.Clamp((_now - _phaseAt) / 4700, 0, 1);
        <rect width="1000" height="1000" fill="black" opacity="@opacity"/>
      }
    }
  </svg>

  @if (_phase == Phase.Warning)
  {
    <div class="warning">
      <p><strong>FLASHING LIGHTS & SOUND</strong></p>
      <p>Sudden bright bursts may affect people sensitive to flashing lights. Keep volume comfortable.</p>
      <button @onclick="Start">START</button>
    </div>
  }
  else if (_phase == Phase.Input && _now - _phaseAt > 8500 && !_touched)
  {
    <p class="help">TAP THE LIGHTS IN ORDER</p>
  }
  else if (_phase == Phase.Finished)
  {
    <button class="restart" @onclick="Start" aria-label="Restart game"></button>
  }

  @if (_soundId > 0)
  {
    <audio @key="_soundId" src="@_soundPath" autoplay preload="auto"></audio>
  }
</div>

@code {
  // All gameplay, timing, randomness and rendering decisions are C#.
  // Perl generates the original audio files at build time.
  private enum Phase { Warning, Pause, Showing, Handoff, Input, Success, Miss, Fade, Finished }
  private sealed record Signal(double X, double Y, int Color, int Style, double Angle);
  private sealed record Burst(double X, double Y, string Color, int Style, double Angle, long Born);
  private sealed record Puff(double X, double Y, string Color, double Vx, double Vy, double Radius, double Opacity, long Born, double Life);

  private static readonly string[] Colors = { "#ff4b55", "#448bff", "#42e5ad", "#ff9a30", "#ff4dc6", "#b77aff" };
  private static readonly string[] Names = { "red", "blue", "green", "orange", "pink", "violet" };
  private readonly Random _rng = new();
  private readonly List<Signal> _sequence = new();
  private readonly List<Burst> _bursts = new();
  private readonly List<Puff> _smoke = new();
  private CancellationTokenSource? _stop;
  private Phase _phase = Phase.Warning;
  private long _now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
  private long _phaseAt;
  private long _nextAt;
  private int _round, _shown, _entered, _soundId;
  private string _soundPath = "";
  private bool _touched;

  protected override void OnInitialized()
  {
    _stop = new CancellationTokenSource();
    _ = RunAsync(_stop.Token);
  }

  private async Task RunAsync(CancellationToken token)
  {
    try
    {
      using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(40));
      while (await timer.WaitForNextTickAsync(token))
      {
        _now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Tick();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (OperationCanceledException) { }
  }

  private void Start()
  {
    _round = 0;
    _smoke.Clear();
    _bursts.Clear();
    _touched = false;
    NextRound();
  }

  private void NextRound()
  {
    _round++;
    _sequence.Clear();
    _bursts.Clear();
    _shown = _entered = 0;
    _touched = false;
    var count = _round <= 2 ? 2 : _round <= 4 ? 3 : 4;
    for (var i = 0; i < count; i++)
    {
      double x = 90, y = 90;
      for (var tries = 0; tries < 90; tries++)
      {
        x = 100 + _rng.NextDouble() * 800;
        y = 120 + _rng.NextDouble() * 740;
        if (_sequence.All(q => Math.Sqrt(Math.Pow(x - q.X, 2) + Math.Pow(y - q.Y, 2)) > (_round < 8 ? 200 : 145))) break;
      }
      var color = _rng.Next(Colors.Length);
      if (_sequence.Count > 0 && color == _sequence[^1].Color) color = (color + 1) % Colors.Length;
      _sequence.Add(new Signal(x, y, color, _rng.Next(5), _rng.NextDouble() * 6.283185307));
    }
    _phase = Phase.Pause;
    _phaseAt = _now;
    _nextAt = _now + 900;
    Play("intro");
  }

  private void BurstAt(Signal signal)
  {
    _bursts.Add(new Burst(signal.X, signal.Y, Colors[signal.Color], signal.Style, signal.Angle, _now));
    // Each burst has an identifiable ignition plus 2–3 seconds of colored smoke.
    // Later rounds extend the lingering haze; sequence length stops increasing at four.
    var life = Math.Min(6800, 2300 + Math.Max(0, _round - 4) * 360);
    for (var i = 0; i < 13; i++)
    {
      var angle = _rng.NextDouble() * Math.PI * 2;
      var speed = 18 + _rng.NextDouble() * 105;
      _smoke.Add(new Puff(signal.X, signal.Y, Colors[signal.Color],
        Math.Cos(angle) * speed, Math.Sin(angle) * speed,
        11 + _rng.NextDouble() * 23, 0.14 + _rng.NextDouble() * 0.13, _now, life));
    }
    Play(Names[signal.Color]);
  }

  private void Play(string name)
  {
    _soundPath = "sounds/" + name + ".wav";
    _soundId++;
    // A new HTML audio element with autoplay is rendered by Blazor.
    // Some mobile browsers may mute automatic playback despite an initial tap.
  }

  private void Tick()
  {
    _bursts.RemoveAll(x => _now - x.Born > 700);
    _smoke.RemoveAll(x => _now - x.Born > x.Life);
    switch (_phase)
    {
      case Phase.Pause:
        if (_now >= _nextAt) { _phase = Phase.Showing; _phaseAt = _now; _nextAt = _now + 120; }
        break;
      case Phase.Showing:
        if (_shown < _sequence.Count && _now >= _nextAt)
        {
          BurstAt(_sequence[_shown++]);
          _nextAt = _now + 1450;
        }
        else if (_shown == _sequence.Count && _now >= _nextAt)
        {
          _phase = Phase.Handoff;
          _phaseAt = _now;
          Play("handoff");
        }
        break;
      case Phase.Handoff:
        if (_now - _phaseAt > 950) { _phase = Phase.Input; _phaseAt = _now; }
        break;
      case Phase.Success:
        if (_now - _phaseAt > 1150)
        {
          if (_round >= 16) { _phase = Phase.Fade; _phaseAt = _now; Play("finale"); }
          else NextRound();
        }
        break;
      case Phase.Miss:
        if (_now - _phaseAt > 1150)
        {
          _shown = _entered = 0;
          _touched = false;
          _phase = Phase.Pause;
          _phaseAt = _now;
          _nextAt = _now + 750;
        }
        break;
      case Phase.Fade:
        if (_now - _phaseAt > 5000) { _phase = Phase.Finished; _smoke.Clear(); _bursts.Clear(); }
        break;
    }
  }

  private void Press(int index)
  {
    if (_phase != Phase.Input) return;
    _touched = true;
    if (index != _entered)
    {
      _phase = Phase.Miss;
      _phaseAt = _now;
      Play("miss");
      return;
    }
    BurstAt(_sequence[index]);
    _entered++;
    if (_entered == _sequence.Count)
    {
      _phase = Phase.Success;
      _phaseAt = _now;
      Play("good");
    }
  }

  private void BackgroundTap()
  {
    if (_phase == Phase.Finished || _phase == Phase.Warning) Start();
  }

  public ValueTask DisposeAsync()
  {
    _stop?.Cancel();
    _stop?.Dispose();
    return ValueTask.CompletedTask;
  }
}
